[Unit]
Description=SQ hosting ranch.phext for Bickford Llama Ranch
After=network.target

[Service]
# SQ binds 0.0.0.0 in `sq host` mode, so the --key is mandatory and the host
# firewall must not expose 18765 publicly; nginx is the only intended client.
Type=simple
User=wbic16
EnvironmentFile=/etc/bickford-llama-ranch/sq.env
ExecStart=/usr/local/bin/sq host 18765 --key ${RANCH_SQ_KEY} --data-dir /srv/bickford-llama-ranch/data
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
